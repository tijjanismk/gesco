{
  "name": "gesco-video",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.8.193 preview",
    "check": "npx --yes hyperframes@0.8.193 check",
    "check:vertical": "sh outils/verifier-vertical.sh check",
    "render": "npx --yes hyperframes@0.8.193 render --quality high --output renders/GESCO-16x9.mp4",
    "render:vertical": "npx --yes hyperframes@0.8.193 render --composition compositions/vertical.html --quality high --output renders/GESCO-9x16.mp4"
  },
  "devDependencies": {
    "@fontsource/fira-sans": "5.3.0",
    "gsap": "3.15.0",
    "hyperframes": "0.8.193"
  }
}
